<ui:FluentWindow x:Class="DeskFences.FenceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 MinWidth="160" MinHeight="100"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowStartupLocation="Manual"
                 AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Colour layer: behind everything, covers the whole fence. -->
        <Border x:Name="TintLayer" Grid.RowSpan="2" />

        <ui:TitleBar x:Name="TitleBarControl"
                     Grid.Row="0"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="False"
                     Height="32" />

        <!-- Shown only while renaming; sits over the title text. -->
        <TextBox x:Name="RenameBox" Grid.Row="0"
                 Visibility="Collapsed" Height="24" Margin="8,4,8,0"
                 VerticalContentAlignment="Center" Padding="4,0"
                 Background="#40FFFFFF" Foreground="White" BorderThickness="0"
                 KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />

        <ScrollViewer Grid.Row="1" Margin="12,0,12,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TileList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Root" Width="84" Padding="4" CornerRadius="6"
                                Background="Transparent"
                                MouseLeftButtonDown="Tile_MouseLeftButtonDown">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="Tile_Open_Click" />
                                    <MenuItem Header="Open file location" Click="Tile_OpenLocation_Click" />
                                    <Separator />
                                    <MenuItem Header="Remove from fence" Click="Tile_Remove_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <Image Source="{Binding Icon}" Width="48" Height="48" />
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White" FontSize="12"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="34"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
